# Public frontend settings (NEXT_PUBLIC_* values are included in browser bundles).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Horizon endpoint used for Stellar network requests; select the matching network.
NEXT_PUBLIC_STELLAR_RPC_URL=https://horizon-testnet.stellar.org

# Application identity
NEXT_PUBLIC_APP_NAME=EzPay
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_ENABLE_WALLET_CONNECT=true
NEXT_PUBLIC_ENABLE_QR_PAYMENTS=true
NEXT_PUBLIC_ENABLE_PAYMENT_LINKS=true

# Optional analytics; analytics ID is public and must not be a secret.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ANALYTICS_ID=

