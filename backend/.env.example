# Backend server
PORT=3001
HOST=0.0.0.0
RUST_LOG=ezpay_backend=info,tower_http=info

# Stellar Horizon connection (testnet defaults; use mainnet values together)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# PostgreSQL (required)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ezpay
DB_MAX_CONNECTIONS=5

# Optional integration settings. JWT and rate limiting are not implemented yet.
JWT_SECRET=
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
ANCHOR_API_KEY=
