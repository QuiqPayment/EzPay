# EzPay Smart Contract
# Soroban deployment configuration. Never commit a populated .env file.

# Select testnet or mainnet and keep its RPC URL and passphrase in sync.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Soroban CLI deployment signer secret/identity. Required to deploy; do not share.
SECRET_KEY=

# Set after deployment; used by later invoke/initialize commands.
CONTRACT_ID=
ADMIN_ADDRESS=
